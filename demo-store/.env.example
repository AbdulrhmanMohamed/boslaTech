# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Sender on your verified Resend domain
RESEND_FROM=أصل <no-reply@boslatech.com>
# Optional: force every email to this address while testing
RESEND_TO=
# Public site URL used inside email links
SITE_URL=http://localhost:5174
# Optional: secret for signing password-reset links (falls back to RESEND_API_KEY)
RESET_SECRET=

# Moyasar — https://dashboard.moyasar.com
# Secret key: server-side only, never expose to the browser
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxx
# Publishable key: safe for the browser (used by the payment form)
VITE_MOYASAR_PUBLIC_KEY=pk_test_xxxxxxxxx
